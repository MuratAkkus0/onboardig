# Copy to .env.prod (never commit it) and fill in every value.
# Start:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Public address users open in the browser (scheme + host [+ port]); must match exactly,
# otherwise sign-in is rejected by the origin check.
APP_URL=https://onboarding.example.com
# Host port the app listens on
APP_PORT=3000
LOG_LEVEL=info

# Better Auth signing secret, at least 32 characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL (the app connects as this user). Use URL-safe characters only:  openssl rand -hex 24
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=
POSTGRES_DB=onboarding

# Mail (see docs/runbook.md, "Echten SMTP-Server anbinden")
MAIL_TRANSPORT=smtp
MAIL_FROM="Startklar <noreply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Only for the one-off tools container (first admin, non-interactive). Remove afterwards.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# Optional password for scripts/seed-demo.ts (min. 12 characters), otherwise random
# SEED_DEMO_PASSWORD=
