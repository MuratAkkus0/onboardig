{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/murat.akkus/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/murat.akkus/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if [ -f graphify-out/graph.json ]; then /Users/murat.akkus/.local/bin/graphify update . >> graphify-out/.auto-update.log 2>&1; fi; exit 0",
            "timeout": 120
          }
        ]
      }
    ]
  }
}